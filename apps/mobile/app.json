{
  "expo": {
    "name": "42go",
    "slug": "42go",
    "icon": "./assets/app-icon.png",
    "scheme": "intra42",
    "plugins": [
      "expo-router",
      "expo-updates",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "com.42go.intra"
    },
    "android": {
      "package": "dev.intra42.mobile"
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
