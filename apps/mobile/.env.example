# Native sign-in service origin. HTTP loopback is accepted only in development.
EXPO_PUBLIC_INTRA42_OAUTH_URL=https://your-login-host.example
# Server-only credentials for allow-listed /v2 data and CDN reads.
INTRA42_CLIENT_ID=
INTRA42_CLIENT_SECRET=
PORT=8787
# Optional: only needed by the legacy registered OAuth endpoints.
# INTRA42_REDIRECT_URI=https://your-login-host.example/callback

# Optional: use a sessions.json file inside a private directory (0700).
# INTRA42_SESSION_FILE=/private/path/intra42/sessions.json
