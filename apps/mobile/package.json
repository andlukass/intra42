    "@tanstack/react-query": "5.103.2",
    "expo": "~57.0.23",
    "expo-blur": "~57.0.3",
    "expo-build-properties": "~57.0.24",
    "expo-constants": "~57.0.20",
    "expo-crypto": "~57.0.0",
    "expo-dev-client": "~57.0.21",
    "expo-file-system": "~57.0.7",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.24",
